+static void
+ud_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint32_t ticks = 0;
+	uint32_t test_panic = 0;     /* sweetusbpanic=N: panic N s after the host configured us */
+	uint32_t configured_ms = 0;
+
+	PE_parse_boot_argn("sweetusbpanic", &test_panic, sizeof(test_panic));
+	for (;;) {
+		if (ud.panic) {
+			/* the panicking CPU drives the controller now */
+			(void)assert_wait(&ud.panic, THREAD_UNINT);
+			thread_block(THREAD_CONTINUE_NULL);
+			continue;
+		}
+		ud_service(&ticks);
+		if (test_panic && ud.configured && ++configured_ms >= test_panic * 1000) {
+			panic("SWEET USB: test panic (sweetusbpanic=%u)", test_panic);
+		}
 		ud_sleep_ms(1);
 	}
 }
 
+/*
+ * Panic: the USB thread no longer runs, so stream the rest of the console
+ * ring (the panic report) from here, polling the controller, and keep doing
+ * so - answering the host and its reboot request - for good. Returns only if
+ * no host has configured the log device within 3 s. Called from
+ * panic_spin_forever() and before the panic restart (osfmk/kern/debug.c).
+ */
+void sweet_usb_panic_flush(void);
+
+void
+sweet_usb_panic_flush(void)
+{
+	static bool entered;
+	uint32_t ticks = 0;
+
+	if (!ud.logmode || !ud.dma || entered) {
+		return;
+	}
+	entered = true;
+	ud.panic = true;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	/* The panic report (registers, backtraces, ...) goes to the panic log
+	 * buffer, not the console: send it after the console text. */
+	extern char *debug_buf_base, *debug_buf_ptr;
+	if (debug_buf_base && debug_buf_ptr > debug_buf_base) {
+		static const char b[] = "\n===== SWEET USB: panic log buffer =====\n";
+		static const char e[] = "\n===== SWEET USB: end of panic log; usblog.py --reboot resets =====\n";
+		sweet_log_append(b, sizeof(b) - 1);
+		/* text only: the binary panic stackshot (kcdata) follows it */
+		int len = (int)strnlen(debug_buf_base, (size_t)(debug_buf_ptr - debug_buf_base));
+		sweet_log_append(debug_buf_base, len);
+		sweet_log_append(e, sizeof(e) - 1);
+	}
+	uint64_t start = mach_absolute_time(), ms_abs;
+	nanoseconds_to_absolutetime(NSEC_PER_MSEC, &ms_abs);
+	uint64_t next = start;
+	for (;;) {
+		ud_service(&ticks);
+		if (!ud.configured && mach_absolute_time() - start > 3000 * ms_abs) {
+			return;
+		}
+		next += ms_abs;      /* ~1 ms per pass: the reboot request counts passes */
+		while (mach_absolute_time() < next) {
+		}
+	}
+}
