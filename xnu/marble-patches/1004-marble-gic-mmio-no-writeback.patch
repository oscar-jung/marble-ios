diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 3362209..587eab9 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -34,22 +34,35 @@ static vm_offset_t gicd_base;
 static vm_offset_t gicr_base;
 static vm_offset_t gicr_size;
 
+/*
+ * marble: one plain load/store per access, never a writeback or pair form.
+ * Under a hypervisor that emulates the GIC (Gunyah on SM7475) a trapped
+ * access is only decodable when ESR_EL2.ISV is set, which excludes
+ * pre/post-indexed and LDP/STP forms; the compiler picked
+ * "str w9, [x8, #0x80]!" for GICR_IGROUPR0 and Gunyah answered with a
+ * synchronous external abort. Same reason Linux's __raw_readl/__raw_writel
+ * are inline asm.
+ */
 static uint32_t
 _gic_read32(vm_offset_t addr)
 {
-	return *((volatile uint32_t *) addr);
+	uint32_t value;
+	__asm__ volatile ("ldr %w0, [%1]" : "=r"(value) : "r"(addr) : "memory");
+	return value;
 }
 
 static uint64_t
 _gic_read64(vm_offset_t addr)
 {
-	return *((volatile uint64_t *) addr);
+	uint64_t value;
+	__asm__ volatile ("ldr %0, [%1]" : "=r"(value) : "r"(addr) : "memory");
+	return value;
 }
 
 static void
 _gic_write32(vm_offset_t addr, uint32_t value)
 {
-	*((volatile uint32_t *) addr) = value;
+	__asm__ volatile ("str %w0, [%1]" : : "rZ"(value), "r"(addr) : "memory");
 }
 
 #define gicd_read32(offset) (_gic_read32(gicd_base + (offset)))
