diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index 9a748ea..763654e 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -61,7 +61,9 @@ MACHINE_FLAGS_ARM64_T8103 = -DARM64_BOARD_CONFIG_T8103                  -mcpu=ap
 MACHINE_FLAGS_ARM64_T6000 = -DARM64_BOARD_CONFIG_T6000 		-mcpu=apple-a14
 MACHINE_FLAGS_ARM64_VMAPPLE = -DARM64_BOARD_CONFIG_VMAPPLE              -march=armv8.5a
 MACHINE_FLAGS_ARM64_BCM2837 = -DARM64_BOARD_CONFIG_BCM2837
-MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -march=armv8.2-a+crypto
+# marble: the same SWEET config, built for another board by passing board
+# defines in the environment, e.g. SWEET_BOARD_FLAGS=-DSWEET_BOARD_MARBLE
+MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -march=armv8.2-a+crypto $(SWEET_BOARD_FLAGS)
 
 
 #
diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 06bb568..91e275b 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1843,7 +1843,7 @@ sweet_early_map_final(void)
 	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
 	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
 	assert(*slot == ARM_TTE_EMPTY);
-	*slot = 0x9c000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+	*slot = (uint64_t)SWEET_FB_PHYS | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
 	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
 	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
 	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 023086f..b2682cb 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -515,7 +515,7 @@ LEXT(start_first_cpu)
 
 #if defined(SWEET)
 	/* Stage 0: white 64x32 band, no stack or page tables needed. */
-	MOV64	x0, (0x9c000000 + 2368 * 4320)
+	MOV64	x0, (SWEET_FB_PHYS + 2368 * 4320)
 	mov		w1, #-1
 	mov		x2, #32
 	mov		x4, #4320
@@ -686,7 +686,7 @@ Lkernelcache_base_found:
 	 * SWEET uses 16K pages and all bring-up RAM is below 4GB, so the first
 	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
 	 */
-	MOV64	x10, 0x9c000000
+	MOV64	x10, SWEET_FB_PHYS
 	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 6928957..dba02c1 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -11,7 +11,7 @@
 #include <stdint.h>
 #include <kern/misc_protos.h>
 
-static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9c000000;
+static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)SWEET_FB_PHYS;
 #define EARLY_FB early_fb
 #define EARLY_WIDTH 1080u
 #define EARLY_HEIGHT 2400u
diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
index b99c2f4..ec30d8f 100644
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -50,6 +50,20 @@
 #define SWEET_VTIMER_INTID        19
 #define SWEET_IPI_SGI             1       // SGI used for cross-CPU signals
 
+/*
+ * Boot framebuffer (the ABL/LK splash surface, 1080x2400, stride 4320), used
+ * VA=PA by start.s and sweet_early.c before the ADT is parsed.
+ *   sweet  (SM7150): cont_splash_region 0x9c000000
+ *   marble (SM7475, POCO F5): cont_splash_region 0xb8000000. 0x9c000000 is
+ *          inside the MPSS/ADSP carve-outs there.
+ * Both are 32 MiB aligned (start.s maps one L2 block).
+ */
+#if defined(SWEET_BOARD_MARBLE)
+#define SWEET_FB_PHYS             0xb8000000
+#else
+#define SWEET_FB_PHYS             0x9c000000
+#endif
+
 #define GIC_SPURIOUS_IRQ          1023    // IRQ no. for GIC spurious interrupt
 
 #define GICR_PE_SIZE              0x20000 // Size of each redistributor region
